@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

@{

}

<div class="w-full max-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-purple-50 p-4">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-xl p-8">

            <!-- Header -->
            <div class="text-center mb-8">
                <h1 class="text-2xl font-semibold text-gray-900 mb-2">Locust - Register</h1>
                <p class="text-gray-600">A safe space for positive connections</p>
            </div>

            <!-- Form -->
            <form id="account" method="post" class="space-y-4" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

                <div>
                    <label asp-for="Input.Email" class="block text-gray-700 mb-2"></label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
                            <!-- mail svg -->
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
                                <path d="M4 6h16v12H4V6z" stroke="currentColor" stroke-width="2" />
                                <path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="2" />
                            </svg>
                        </span>
                        <input asp-for="Input.Email" 
                               class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                               placeholder="your@email.com" autocomplete="off" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-red-600 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Input.Password" class="block text-gray-700 mb-2"></label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
                            <!-- lock svg -->
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
                                <path d="M7 11V8a5 5 0 0110 0v3" stroke="currentColor" stroke-width="2" />
                                <path d="M6 11h12v10H6V11z" stroke="currentColor" stroke-width="2" />
                            </svg>
                        </span>
                        <input asp-for="Input.Password"
                               class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                               placeholder="••••••••" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-red-600 text-sm"></span>
                    <ul id="password-rules" class="mt-2 text-sm space-y-1 hidden">
                        <li data-rule="len" class="flex items-center gap-2 text-red-500">
                            <span class="rule-icon">&#10005;</span> Minimaal 6 tekens
                        </li>
                        <li data-rule="lower" class="flex items-center gap-2 text-red-500">
                            <span class="rule-icon">&#10005;</span> Minimaal 1 kleine letter
                        </li>
                        <li data-rule="upper" class="flex items-center gap-2 text-red-500">
                            <span class="rule-icon">&#10005;</span> Minimaal 1 hoofdletter
                        </li>
                        <li data-rule="digit" class="flex items-center gap-2 text-red-500">
                            <span class="rule-icon">&#10005;</span> Minimaal 1 cijfer
                        </li>
                        <li data-rule="nonalnum" class="flex items-center gap-2 text-red-500">
                            <span class="rule-icon">&#10005;</span> Minimaal 1 speciaal teken
                        </li>
                    </ul>

                </div>

                <div>
                    <label asp-for="Input.ConfirmPassword" class="block text-gray-700 mb-2"></label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
                            <!-- lock svg -->
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
                                <path d="M7 11V8a5 5 0 0110 0v3" stroke="currentColor" stroke-width="2" />
                                <path d="M6 11h12v10H6V11z" stroke="currentColor" stroke-width="2" />
                            </svg>
                        </span>
                        <input asp-for="Input.ConfirmPassword"
                               class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                               placeholder="••••••••" autocomplete="new-password"  />
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-red-600 text-sm"></span>
                </div>

                <button type="submit"
                        class="w-full bg-gradient-to-r from-blue-500 to-purple-600 text-white py-3 rounded-lg hover:from-blue-600 hover:to-purple-700 transition-all duration-200 shadow-lg hover:shadow-xl">
                    Create account
                </button>

                <div class="text-center">
                    <a asp-page="./Login"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       class="text-blue-600 hover:text-blue-700 transition-colors">
                        Already have an account? Sign in
                    </a>
                </div>

            </form>

            <!-- Info -->

        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const passwordInput = document.getElementById("Input_Password");
            const rules = document.querySelectorAll("#password-rules li");
            const passwordRules = document.getElementById("password-rules");

                    passwordInput.addEventListener("focus", () => {
          passwordRules.style.display = "block";
        });

        passwordInput.addEventListener("blur", () => {
                    passwordRules.style.display = "none";
        });

            if (!passwordInput) return;

            passwordInput.addEventListener("input", function () {
                const value = passwordInput.value;

                const checks = {
                    len: value.length >= 6,
                    lower: /[a-z]/.test(value),
                    upper: /[A-Z]/.test(value),
                    digit: /[0-9]/.test(value),
                    nonalnum: /[^a-zA-Z0-9]/.test(value)
                };

                rules.forEach(rule => {
                    const ruleName = rule.dataset.rule;
                    const icon = rule.querySelector(".rule-icon");

                    if (checks[ruleName]) {
                        rule.classList.remove("text-red-500");
                        rule.classList.add("text-green-600");
                        icon.innerHTML = "&check;";
                    } else {
                        rule.classList.remove("text-green-600");
                        rule.classList.add("text-red-500");
                        icon.innerHTML = "&#10005;";
                    }
                });
            });
        });
    </script>
}

