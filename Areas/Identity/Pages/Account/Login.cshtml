@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="max-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-purple-50 p-4">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-xl p-8">

            <!-- Header -->
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full mb-4">
                    <!-- simpele shield svg (geen lucide nodig) -->
                    <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="none">
                        <path d="M12 2l7 4v6c0 5-3 9-7 10-4-1-7-5-7-10V6l7-4z" stroke="currentColor" stroke-width="2" />
                    </svg>
                </div>
                <h1 class="text-2xl font-semibold text-gray-900 mb-2">Locust</h1>
                <p class="text-gray-600">A safe space for positive connections</p>
            </div>

            <!-- Form -->
            <form id="account" method="post" class="space-y-4">
                <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

                <div>
                    <label asp-for="Input.Email" class="block text-gray-700 mb-2"></label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
                            <!-- mail svg -->
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
                                <path d="M4 6h16v12H4V6z" stroke="currentColor" stroke-width="2" />
                                <path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="2" />
                            </svg>
                        </span>
                        <input asp-for="Input.Email"
                               class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                               placeholder="your@email.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-red-600 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Input.Password" class="block text-gray-700 mb-2"></label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
                            <!-- lock svg -->
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none">
                                <path d="M7 11V8a5 5 0 0110 0v3" stroke="currentColor" stroke-width="2" />
                                <path d="M6 11h12v10H6V11z" stroke="currentColor" stroke-width="2" />
                            </svg>
                        </span>
                        <input asp-for="Input.Password"
                               class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                               placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-red-600 text-sm"></span>
                </div>

                <button type="submit"
                        class="w-full bg-gradient-to-r from-blue-500 to-purple-600 text-white py-3 rounded-lg hover:from-blue-600 hover:to-purple-700 transition-all duration-200 shadow-lg hover:shadow-xl">
                    Sign In
                </button>

                <div class="text-center">
                    <a asp-page="./Register"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       class="text-blue-600 hover:text-blue-700 transition-colors">
                        Don't have an account? Sign up
                    </a>
                </div>

            </form>

            <!-- Info -->
            <div class="mt-6 p-4 bg-blue-50 rounded-lg">
                <p class="text-sm text-gray-700 text-center">
                    We're committed to creating a bully-free community where kindness comes first.
                </p>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
