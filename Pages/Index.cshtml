@page
@model IndexModel
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@{
    ViewData["Title"] = "Home page";
    object place = new {};
}
@functions{
    
}
}
@foreach (var post in Model.Posts)
{   
    <div class="post mx-[500px] my-[50px] p-[10px] rounded-lg bg-slate-300">
        <a asp-page="/Post" asp-route-id="@post.postID">
            <p class="text-2xl m-[20px]">@post.title</p>
        </a>
        <p class="text-lg m-[20px]">@post.bodyText</p>
        <div class="m-[20px] flex justify-between text-s">
            <div>
                <button>@post.likes</button>
            </div>
            <div>
                <a asp-page="/Post" asp-route-id="@post.postID">@post.comments</a>
            </div>
        </div>
    </div>
}

