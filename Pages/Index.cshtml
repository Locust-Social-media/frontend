@foreach (var post in Model.Posts)
{
    <div id="post1" class="m-[200px] p-[10px] rounded-lg bg-slate-300">
        <p class="text-2xl m-[20px]">@post.title</p>
        <p class="text-lg m-[20px]">@post.text</p>
        <div class="m-[20px] flex justify-between text-xs">
            <div>
                <button>@post.likes</button>
            </div>
            <div>
                <button>@post.comments</button>
            </div>
            <div>
                @* <button onclick="addElement()">share</button> *@
            </div>
        </div>
    </div>
}

