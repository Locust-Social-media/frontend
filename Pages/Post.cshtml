@page "{id:int}"
@model Locust.Pages._PostLayoutModel

@{
    var post = Model.Post;
}

@if (post is null)
{
    <p>Post niet gevonden.</p>
}
else
{
    <div class="post mx-[500px] my-[50px] p-[10px] rounded-lg bg-slate-300">
        <p class="text-3xl m-[20px]">@post.Title</p>
        <p class="text-xl m-[20px]">@post.BodyText</p>

        <div class="m-[20px] flex justify-between text-s">
            <div>
                <button>@post.Likes</button>
            </div>
        </div>
    </div>

    <div class="post mx-[500px] my-[50px] p-[10px] rounded-lg bg-slate-300">
        <p class="text-lg font-semibold m-[20px]">Comments (later)</p>
        @* comments komen later *@
    </div>
}
