<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Locust</title>

    <script src="https://cdn.tailwindcss.com"></script>
    @* optioneel: eigen css *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Head", required: false)
</head>
<body class="min-h-screen max-h-screen bg-gradient-to-br from-blue-50 to-purple-50 text-gray-900 flex flex-col">

    <header class="sticky top-0 z-50 border-b border-white/20 bg-white/70 backdrop-blur">
        <nav class="mx-auto max-w-6xl px-4 py-3 flex items-center justify-between">

            <!-- LINKS: logo + titel + welkom -->
            <a asp-page="/Index" class="flex items-center gap-4 hover:opacity-80 transition">

                <div class="inline-flex items-center justify-center w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full">
                    <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none">
                        <path d="M12 2l7 4v6c0 5-3 9-7 10-4-1-7-5-7-10V6l7-4z"
                              stroke="currentColor" stroke-width="2" />
                    </svg>
                </div>

                <h1 class="text-xl font-semibold text-gray-900">Locust</h1>

            </a>

            <!-- RECHTS: login/register of logout -->
            <div class="flex items-center gap-4">
                <partial name="_LoginPartial" />
            </div>

        </nav>

    </header>

    <main class="flex flex-1 flex-col">
        @RenderBody()
    </main>

    <footer class="border-t border-white/20 bg-white/60">
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
